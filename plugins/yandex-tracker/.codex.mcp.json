{
  "mcpServers": {
    "yandex-tracker": {
      "cwd": ".",
      "command": "node",
      "args": [
        "./dist/bundle.js"
      ],
      "env_vars": [
        "YANDEX_TRACKER_TOKEN",
        "YANDEX_TRACKER_ORG_ID",
        "YANDEX_TRACKER_IAM_TOKEN",
        "YANDEX_TRACKER_CLOUD_ORG_ID"
      ]
    }
  }
}
